{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exam objectives (data/<exam>/objectives.json)",
  "description": "CompTIA's domains, objectives, and bullets, verbatim. Sub-objective ids (1.1.a) are assigned by this site.",
  "type": "object",
  "required": ["domains"],
  "properties": {
    "$schema": { "type": "string" },
    "exam": { "type": "string" },
    "title": { "type": "string" },
    "source": { "type": "string" },
    "notes": { "type": "string" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "objectives"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d+\\.0$" },
          "title": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 100, "description": "Percent of the exam." },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title"],
              "properties": {
                "id": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
                "title": { "type": "string" },
                "subobjectives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^\\d+\\.\\d+\\.[a-z][a-z0-9]*$" },
                      "title": { "type": "string" },
                      "details": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
