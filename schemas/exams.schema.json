{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exam registry (data/exams.json)",
  "description": "Every exam the site knows about. Live exams appear on the home page with Flashcards and Practice test links.",
  "type": "object",
  "required": ["exams"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer" },
    "site": {
      "type": "object",
      "properties": { "title": { "type": "string", "description": "Site name shown in the header and browser tab." } }
    },
    "exams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "code", "name", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "URL id, e.g. a-plus-core-1 (used as ?exam=)." },
          "family": { "type": "string", "description": "A+, Network+, or Security+." },
          "code": { "type": "string", "description": "Exam code, e.g. 220-1201." },
          "name": { "type": "string" },
          "status": { "enum": ["live", "planned", "hidden"] },
          "theme": { "enum": ["aplus", "netplus", "secplus"], "description": "Course color theme." },
          "dataPath": { "type": "string", "description": "Folder holding objectives.json, units.json, flashcards/ and questions/." },
          "blurb": { "type": "string" },
          "plannedNote": { "type": "string" },
          "facts": {
            "type": "object",
            "properties": {
              "maxQuestions": { "type": "integer" },
              "minutes": { "type": "integer" },
              "passingScore": { "type": "string" }
            }
          },
          "sources": {
            "type": "object",
            "description": "Books that references point to, keyed by id (reference.source).",
            "additionalProperties": {
              "type": "object",
              "required": ["title"],
              "properties": { "title": { "type": "string" } }
            }
          }
        },
        "if": { "properties": { "status": { "const": "live" } } },
        "then": { "required": ["dataPath", "sources"] }
      }
    }
  }
}
