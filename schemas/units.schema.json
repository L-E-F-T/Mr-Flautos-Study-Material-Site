{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Textbook units (data/<exam>/units.json)",
  "description": "CertMaster Learn units (3.0) → lessons (3.2) → reading sections (3.2.4). Titles verbatim from the courseware.",
  "type": "object",
  "required": ["units"],
  "properties": {
    "$schema": { "type": "string" },
    "courseware": { "type": "string" },
    "source": { "type": "string" },
    "notes": { "type": "string" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "subunits"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d+\\.0$" },
          "title": { "type": "string" },
          "subunits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "sections"],
              "properties": {
                "id": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
                "title": { "type": "string" },
                "objectives": {
                  "type": "array",
                  "description": "From the lesson's \"Exam Objectives Covered\" box.",
                  "items": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
                      "title": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
